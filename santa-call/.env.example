# Copy this file to .env and fill in ONE backend.
# With nothing set, the app runs in demo mode (no AI, Santa hums).

# --- Recommended for real calls with kids: Google Cloud Vertex AI ---
# Authenticate with `gcloud auth application-default login` (local) or a
# service account (hosted). The Vertex AI API must be enabled on the project.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Adult testing only: Gemini Developer API key (AI Studio) ---
# Its terms forbid apps that are directed at or likely used by under-18s.
# GEMINI_API_KEY=your-key

# Force a backend instead of auto-detecting: vertex | gemini-api | mock
# SANTA_BACKEND=

# Gemini Live model. Check the model list in your console if this changes.
# SANTA_MODEL=gemini-3.8-live

# --- Photoreal Santa (optional): Anam real-time avatar ---
# Create an avatar from a Santa photo with: node scripts/create-santa-avatar.mjs ./santa.jpg
# ANAM_API_KEY=
# ANAM_AVATAR_ID=
# ANAM_AVATAR_MODEL=cara-4
# Force the illustrated Santa even when Anam keys are set: illustrated | anam
# SANTA_AVATAR=

# Require a code on the call screen so strangers who find the URL can't use your credits.
# SANTA_ACCESS_CODE=

# Server
# PORT=8787
# HOST=127.0.0.1          # use 0.0.0.0 when hosting
# MAX_SESSIONS=5          # simultaneous calls
# MAX_CALL_MINUTES=30     # hard stop per call
# ALLOWED_ORIGINS=        # extra origins allowed to open calls, comma-separated

# How the helper panel's notes reach Santa: client-content (default) | realtime
# SANTA_TEXT_INPUT=client-content
